<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_defaultbackground"
    tools:context=".Municipality">

    <TextView
        android:id="@+id/tvMunicipalityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:textAlignment="center"
        android:textColor="@color/color_textlight"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Beijing" />

    <ImageView
        android:id="@+id/ivMunicipalityImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toBottomOf="@id/tvMunicipalityName"
        tools:src="@drawable/beijing" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnVisitSite"
        app:layout_constraintTop_toBottomOf="@id/ivMunicipalityImage">

        <TextView
            android:id="@+id/tvMunicipalityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="Beijing is the capital of China..."
            tools:textColor="@color/municipality_Beijing" />
    </ScrollView>

    <Button
        android:id="@+id/btnVisitSite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:padding="12dp"
        android:text="@string/visit_site"
        android:textColor="@color/color_textlight"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:backgroundTint="@color/municipality_Beijing" />

</androidx.constraintlayout.widget.ConstraintLayout>